{
  "name": "raven-vscode",
  "displayName": "Raven",
  "description": "VS Code extension for the Raven language server.",
  "version": "0.1.10",
  "publisher": "raven",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marinasundstrom/raven.git"
  },
  "homepage": "https://github.com/marinasundstrom/raven#readme",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:raven",
    "onDebug:raven",
    "onCommand:raven.run.compileAndRun",
    "onCommand:raven.debug.compileAndDebug",
    "onCommand:raven.build.activeTarget",
    "onCommand:raven.build.clean",
    "onCommand:raven.toggleInlayHints",
    "onCommand:raven.toggleInferredTypeInlayHints",
    "onCommand:raven.toggleNameInlayHints",
    "onCommand:raven.showMacroExpansion",
    "onCommand:raven.showCodeActionPreview",
    "onCommand:raven.showToolchainInfo",
    "onCommand:raven.syntaxTree.refresh",
    "onCommand:raven.syntaxTree.showAuthored",
    "onCommand:raven.syntaxTree.showExpanded",
    "onCommand:raven.syntaxTree.showExpandedDocument",
    "onView:raven.syntaxTree",
    "onCommand:raven.openDocumentation"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "raven",
        "aliases": [
          "Raven",
          "raven"
        ],
        "extensions": [
          ".rvn",
          ".rav"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "raven.run.compileAndRun",
        "title": "Raven: Run Active File/Project"
      },
      {
        "command": "raven.debug.compileAndDebug",
        "title": "Raven: Compile and Debug"
      },
      {
        "command": "raven.build.activeTarget",
        "title": "Raven: Build Active File/Project"
      },
      {
        "command": "raven.build.clean",
        "title": "Raven: Clean Build Artifacts"
      },
      {
        "command": "raven.toggleInlayHints",
        "title": "Raven: Toggle Inlay Hints"
      },
      {
        "command": "raven.toggleInferredTypeInlayHints",
        "title": "Raven: Toggle Inferred Type Inlay Hints"
      },
      {
        "command": "raven.toggleNameInlayHints",
        "title": "Raven: Toggle Name Inlay Hints"
      },
      {
        "command": "raven.showMacroExpansion",
        "title": "Raven: Show Macro Expansion"
      },
      {
        "command": "raven.showCodeActionPreview",
        "title": "Raven: Show Code Action Preview"
      },
      {
        "command": "raven.showToolchainInfo",
        "title": "Raven: Show Toolchain Information"
      },
      {
        "command": "raven.syntaxTree.refresh",
        "title": "Raven: Refresh Syntax Tree",
        "icon": "$(refresh)"
      },
      {
        "command": "raven.syntaxTree.showAuthored",
        "title": "Raven: Show Authored Syntax Tree",
        "icon": "$(file-code)"
      },
      {
        "command": "raven.syntaxTree.showExpanded",
        "title": "Raven: Show Expanded Syntax Tree",
        "icon": "$(symbol-structure)"
      },
      {
        "command": "raven.syntaxTree.showExpandedDocument",
        "title": "Raven: Open Expanded Document",
        "icon": "$(open-preview)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "raven.syntaxTree",
          "name": "Raven Syntax Tree"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "raven.syntaxTree.refresh",
          "when": "view == raven.syntaxTree",
          "group": "navigation"
        },
        {
          "command": "raven.syntaxTree.showExpanded",
          "when": "view == raven.syntaxTree && raven.syntaxTreeView == authored",
          "group": "navigation@1"
        },
        {
          "command": "raven.syntaxTree.showAuthored",
          "when": "view == raven.syntaxTree && raven.syntaxTreeView == expanded",
          "group": "navigation@1"
        },
        {
          "command": "raven.syntaxTree.showExpandedDocument",
          "when": "view == raven.syntaxTree",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "raven.run.compileAndRun",
          "when": "resourceExtname == .rvn || resourceExtname == .rav || resourceExtname == .rvnproj",
          "group": "navigation"
        },
        {
          "command": "raven.debug.compileAndDebug",
          "when": "resourceExtname == .rvn || resourceExtname == .rav || resourceExtname == .rvnproj",
          "group": "navigation"
        },
        {
          "command": "raven.build.activeTarget",
          "when": "resourceExtname == .rvn || resourceExtname == .rav || resourceExtname == .rvnproj",
          "group": "navigation@1"
        },
        {
          "command": "raven.build.clean",
          "when": "resourceExtname == .rvn || resourceExtname == .rav || resourceExtname == .rvnproj",
          "group": "navigation@2"
        }
      ]
    },
    "debuggers": [
      {
        "type": "raven",
        "label": "Raven",
        "languages": [
          "raven"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [],
            "properties": {
              "target": {
                "type": "string",
                "description": "Path to a .rvn, .rvnproj, or .rav file. Defaults to the active editor file."
              },
              "project": {
                "type": "string",
                "description": "Alias for target when launching a Raven project file."
              },
              "startupProject": {
                "type": "string",
                "description": "Optional .NET startup project to build and launch while debugging the Raven target, such as a Blazor host that references a Raven component project."
              },
              "launchProfile": {
                "type": "string",
                "description": "Optional Project launch profile from the startup project's Properties/launchSettings.json."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "raven",
            "request": "launch",
            "name": "Raven: Compile and Debug",
            "target": "${file}"
          }
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "raven"
      }
    ],
    "grammars": [
      {
        "language": "raven",
        "scopeName": "source.raven",
        "path": "./syntaxes/raven.tmLanguage.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "ravenDocumentationTag",
        "superType": "keyword",
        "description": "A structured tag in Raven Markdown documentation."
      },
      {
        "id": "ravenDocumentationHeading",
        "superType": "comment",
        "description": "A heading marker in Raven Markdown documentation."
      },
      {
        "id": "ravenDocumentationCode",
        "superType": "string",
        "description": "Inline or fenced code in Raven Markdown documentation."
      },
      {
        "id": "ravenDocumentationLink",
        "superType": "string",
        "description": "A link in Raven Markdown documentation."
      },
      {
        "id": "ravenInactiveCode",
        "superType": "comment",
        "description": "Source excluded by Raven conditional compilation."
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "raven",
        "scopes": {
          "keyword": [
            "keyword.other.using.raven",
            "keyword.other.alias.raven",
            "keyword.control.conditional.raven",
            "keyword.control.loop.raven",
            "keyword.control.lock.raven",
            "keyword.control.exception.raven",
            "keyword.control.flow.raven",
            "keyword.control.async.raven",
            "keyword.declaration.constraint.raven",
            "keyword.other.expression.raven",
            "keyword.control.raven",
            "keyword.other.conversion.raven",
            "keyword.other.raven",
            "keyword"
          ],
          "string": [
            "string.quoted.double.raven"
          ],
          "number": [
            "constant.numeric.raven"
          ],
          "comment": [
            "comment.raven"
          ],
          "ravenInactiveCode": [
            "comment.block.preprocessor.inactive.raven"
          ],
          "operator": [
            "keyword.operator.word.raven",
            "keyword.operator.raven"
          ],
          "namespace": [
            "entity.name.namespace.raven",
            "entity.name.namespace"
          ],
          "type": [
            "entity.name.type.raven",
            "entity.name.type"
          ],
          "class": [
            "entity.name.type.raven",
            "entity.name.type"
          ],
          "struct": [
            "entity.name.type.raven",
            "entity.name.type"
          ],
          "interface": [
            "entity.name.type.raven",
            "entity.name.type"
          ],
          "enum": [
            "entity.name.type.raven",
            "entity.name.type"
          ],
          "method": [
            "entity.name.function.raven",
            "entity.name.function"
          ],
          "property": [
            "variable.other.property.raven",
            "variable.other.property",
            "variable.other"
          ],
          "variable": [
            "variable.other.raven",
            "variable.other"
          ],
          "parameter": [
            "variable.parameter.raven",
            "variable.parameter"
          ],
          "label": [
            "entity.name.label.raven",
            "entity.name.label"
          ],
          "event": [
            "entity.name.event.raven",
            "entity.name.event",
            "variable.other.property"
          ],
          "ravenDocumentationTag": [
            "storage.type.annotation.documentation.raven"
          ],
          "ravenDocumentationHeading": [
            "markup.heading.markdown"
          ],
          "ravenDocumentationCode": [
            "markup.inline.raw.string.markdown"
          ],
          "ravenDocumentationLink": [
            "markup.underline.link.markdown"
          ],
          "type.defaultLibrary": [
            "support.type.builtin.raven",
            "support.type"
          ],
          "class.defaultLibrary": [
            "support.type.builtin.raven",
            "support.type"
          ],
          "struct.defaultLibrary": [
            "support.type.builtin.raven",
            "support.type"
          ],
          "method.defaultLibrary": [
            "support.function.raven",
            "support.function"
          ],
          "property.readonly": [
            "variable.other.constant.property.raven",
            "variable.other.property.raven",
            "variable.other.property"
          ],
          "variable.readonly": [
            "variable.other.constant.raven",
            "variable.other.raven",
            "variable.other"
          ],
          "parameter.readonly": [
            "variable.parameter.raven",
            "variable.parameter"
          ]
        }
      }
    ],
    "configuration": {
      "title": "Raven",
      "properties": {
        "raven.languageServerPath": {
          "type": "string",
          "default": "",
          "description": "Full path to Raven.LanguageServer.dll. Leave empty to auto-discover a sibling 'server/Raven.LanguageServer.dll' next to the extension or a workspace copy under src/Raven.LanguageServer/bin/Debug/net10.0."
        },
        "raven.autoBuildLanguageServerOnActivate": {
          "type": "boolean",
          "default": false,
          "description": "When enabled, build src/Raven.LanguageServer/Raven.LanguageServer.csproj before launching the language server. This can significantly delay activation and is intended only for source-workspace development. Ignored when raven.languageServerPath is set."
        },
        "raven.inlayHints.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show Raven inlay hints. When disabled, all Raven inlay hint categories are hidden regardless of their individual settings."
        },
        "raven.inlayHints.inferredTypes.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show inferred local type annotations and inferred function return type annotations when Raven inlay hints are enabled."
        },
        "raven.inlayHints.names.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show name inlay hints when Raven inlay hints are enabled, including invocation parameter names and deconstruction element names."
        },
        "raven.inlayHints.requestDebounceMilliseconds": {
          "type": "number",
          "default": 250,
          "minimum": 0,
          "maximum": 2000,
          "description": "Delay inlay hint requests briefly after Raven document edits so typing coalesces before semantic inlay work reaches the language server. Set to 0 to disable client-side debouncing."
        },
        "raven.semanticTokens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Request Raven semantic tokens from the language server. Disable to rely on TextMate syntax highlighting while testing language-server semantic responsiveness."
        },
        "raven.sdkPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to a Raven SDK directory containing bundled tools and assemblies such as Raven.LanguageServer.dll, rvn.dll, rvnc.dll, and Raven.Core.dll. When set, the extension prefers this SDK for language-server and compiler resolution."
        },
        "raven.compilerProjectPath": {
          "type": "string",
          "default": "",
          "description": "Optional path used to locate a built Raven compiler driver (rvnc.dll) under src/Raven.Compiler/bin/Debug/<tfm>. The extension does not launch Raven.Compiler.csproj via dotnet run."
        },
        "raven.targetFramework": {
          "type": "string",
          "default": "",
          "description": "Target framework to pass to Raven debug compile through the built Raven compiler host, for example 'net10.0'. Leave empty to use defaults."
        },
        "raven.debugStopAtEntry": {
          "type": "boolean",
          "default": false,
          "description": "Pause at program entry before user code runs when launching Raven debug sessions."
        },
        "raven.debugJustMyCode": {
          "type": "boolean",
          "default": false,
          "description": "Use Just My Code when launching Raven debug sessions. Some Raven builds may be classified as non-user code by vsdbg when this is enabled."
        },
        "raven.debugModuleLoadMessages": {
          "type": "boolean",
          "default": false,
          "description": "Show module-load messages in the Debug Console for Raven debug sessions."
        },
        "raven.debugEngineLogging": {
          "type": "boolean",
          "default": false,
          "description": "Enable verbose debugger engine logging for Raven debug sessions."
        },
        "raven.debugExcludeFrameworkModules": {
          "type": "boolean",
          "default": true,
          "description": "Exclude System.* and Microsoft.* modules from symbol loading to reduce framework symbol noise in Raven debug sessions."
        }
      }
    },
    "configurationDefaults": {
      "[raven]": {
        "editor.colorDecorators": false
      },
      "files.associations": {
        "*.rvnproj": "xml"
      }
    }
  },
  "scripts": {
    "check-types": "tsc -p ./tsconfig.json --noEmit",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "lint": "echo 'No lint configuration'",
    "prepare": "npm run compile",
    "package:extension": "npm run check-types && node esbuild.js --production",
    "package": "npm run package:extension && vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "1.80.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.5",
    "@vscode/vsce": "^3.7.1"
  }
}
