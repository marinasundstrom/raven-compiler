import System.*
import System.Console.*
import System.Net.Http.*
import System.Threading.Tasks.*

/* *
* Investigation doc: docs/async-propagate-lowering-plan.md
*
* To compile:
* dotnet run --project ../src/Raven.Compiler --property WarningLevel=0 -- sample101.rav -o test.dll
* dotnet test.dll
*
* Options for debugging:
* -d pretty : render highlighted syntax tree
* -s : display syntax tree
* -b t: display clean binder tree. -bte include error nodes
* --no-emit : skip code gen
* */

// test

let res = await test(throwExc: false)
WriteLine(res)

let res_2 = await test(throwExc: true)
WriteLine(res_2)


// test2

/*
// InvalidProgramException it thrown

let res2 = await test2(throwExc: false)
WriteLine(res2)

let res2_2 = await test2(throwExc: true)
WriteLine(res2_2)

*/


// test3

let res3 = await test3(throwExc: false)
WriteLine(res3)

let res3_2 = await test3(throwExc: true)
WriteLine(res3_2)


// test4

let res4 = await test4(throwExc: false)
WriteLine(res4)

let res4_2 = await test4(throwExc: true)
WriteLine(res4_2)


// test5

let res5 = await test5(throwExc: false)
WriteLine(res5)

let res5_2 = await test5(throwExc: true)
WriteLine(res5_2)


async func test(throwExc: bool) -> Task<Result<string, Exception>> {
    let x = (try await action(throwExc))?
    return Ok("test = OK")
}

async func test2(throwExc: bool) -> Task<Result<string, Exception>> {
    _ = (try await action(throwExc))?
    return Ok("test2 = OK")
}

async func test3(throwExc: bool) -> Task<Result<string, Exception>> {
    (try await action(throwExc))?
    return Ok("test3 = OK")
}

async func test4(throwExc: bool) -> Task<Result<string, Exception>> {
    let x = ((try await action2(throwExc))?)?
    return Ok(x)
}

async func test5(throwExc: bool) -> Task<Result<string, Exception>> {
    ((try await action2(throwExc))?)?
    return Ok("test5 = OK")
}

async func action(throwExc: bool) -> Task {
    await Task.Delay(200)
    if throwExc {
        throw Exception("Boom!")
    }
}

async func action2(throwExc: bool) -> Task<Result<string, Exception>> {
    await Task.Delay(200)
    if throwExc {
        throw Exception("Boom!")
    }
    return Ok("Foo")
}
