{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "overview.md",
          "roadmap.md",
          "toc.yml",
          "learn.md",
          "raven-in-60-seconds.md",
          "getting-started.md",
          "introduction.md",
          "raven-for-absolute-beginners.md",
          "raven-for-csharp-developers.md",
          "workloads/index.md",
          "workloads/toc.yml",
          "workloads/containerization.md",
          "workloads/web-api.md",
          "workloads/file-based-apps.md",
          "workloads/iot-monitor.md",
          "workloads/embedded-iot.md",
          "showcases/toc.yml",
          "showcases/domain-modeling.md",
          "showcases/web-api.md",
          "showcases/embedded-iot.md",
          "showcases/html-components.md",
          "showcases/maui-components.md",
          "macro-authoring.md",
          "libraries/index.md",
          "libraries/toc.yml",
          "lang/README.md",
          "lang/toc.yml",
          "lang/features/index.md",
          "lang/features/toc.yml",
          "lang/features/values-and-functions.md",
          "lang/features/data-modeling.md",
          "lang/features/patterns.md",
          "lang/features/option-and-result.md",
          "lang/features/dotnet-interop.md",
          "lang/features/async.md",
          "lang/features/macros.md",
          "lang/philosophy.md",
          "lang/feature-meaning.md",
          "lang/domain-modeling.md",
          "lang/nullability.md",
          "lang/style-guide.md",
          "lang/spec/toc.yml",
          "lang/spec/index.md",
          "lang/spec/**.md",
          "compiler/index.md",
          "compiler/toc.yml",
          "compiler/raven-compiler.md",
          "compiler/target-platforms.md",
          "compiler/nanoframework.md",
          "compiler/webassembly.md",
          "compiler/browser-wasm.md",
          "compiler/project-system.md",
          "compiler/extending-projects.md",
          "compiler/source-generators.md",
          "compiler/distribution.md",
          "compiler/raven-core-library.md",
          "compiler/raven-macros-library.md",
          "compiler/json-serialization.md",
          "compiler/diagnostics.md",
          "compiler/analyzers/built-in.md",
          "compiler/analyzers/configuration.md",
          "compiler/raven-vscode-extension.md",
          "compiler/distribution.md",
          "status.md"
        ],
        "exclude": []
      }
    ],
    "resource": [
      {
        "files": [
          "images/**",
          "lang/spec/**.ebnf"
        ]
      }
    ],
    "output": "../_site",
    "template": [
      "default",
      "modern",
      "template"
    ],
    "globalMetadata": {
      "_appName": "Raven",
      "_appTitle": "Raven programming language",
      "_appLogoPath": "images/raven-mark.svg",
      "_appFooter": "The official website of the Raven programming language.",
      "_enableSearch": true,
      "pdf": false
    }
  }
}
